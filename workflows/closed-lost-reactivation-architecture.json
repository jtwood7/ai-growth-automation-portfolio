    {
      "parameters": {
        "jsCode": "// DESIGN ASSUMPTION - pure date math, no external tool\nconst out = [];\nconst now = new Date();\nfor (const item of $input.all()) {\n  const closeDate = new Date(item.json.closedate || item.json.close_date);\n  const daysSinceLoss = (now - closeDate) / (1000 * 60 * 60 * 24);\n  if (daysSinceLoss >= 60) {\n    item.json.days_since_loss = Math.floor(daysSinceLoss);\n    item.json.months_since_loss = daysSinceLoss / 30;\n    out.push(item);\n  }\n}\nreturn out;"
      },
      "name": "Apply 60-day floor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        304
      ],
      "notes": "DESIGN ASSUMPTION. Formula off HubSpot close date."
    },
